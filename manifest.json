{
	"manifest_version": 3,
	"name": "Blueskyカスタム拡張機能",
	"version": "2.8.0",
	"description": "Blueskyのプロフィールのメディア欄をサムネイル格子に置き換え、タブを行き来する固定ボタンを追加します。画像ライトボックスには投稿情報パネルと返信・いいね等の操作、誤クリックで閉じない調整、NSFWぼかしの解除も加えます。",
	"permissions": ["storage"],
	"host_permissions": ["https://public.api.bsky.app/*"],
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "Blueskyカスタム拡張機能",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["*://bsky.app/*"],
			"js": ["config.js", "debug.js", "icon-shapes.js", "icons.js", "bridge-client.js", "profile-tabs.js", "content.js", "media-source.js", "media-grid.js", "post-actions.js", "lightbox-panel.js", "lightbox-guard.js"],
			"css": ["style.css"],
			"run_at": "document_end"
		},
		{
			"matches": ["*://bsky.app/*"],
			"js": ["page-bridge.js"],
			"run_at": "document_end",
			"world": "MAIN"
		}
	]
}
