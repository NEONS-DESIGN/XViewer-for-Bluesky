{
	"manifest_version": 3,
	"name": "Blueskyカスタム拡張機能",
	"version": "2.4.1",
	"description": "Blueskyのプロフィールのメディア欄をサムネイル一覧表示に置き換え、タブを行き来する固定ボタンを追加します。",
	"permissions": ["storage"],
	"host_permissions": ["https://public.api.bsky.app/*"],
	"action": {
		"default_popup": "popup.html",
		"default_title": "Blueskyカスタム拡張機能"
	},
	"content_scripts": [
		{
			"matches": ["*://bsky.app/*"],
			"js": ["config.js", "debug.js", "icon-shapes.js", "icons.js", "bridge-client.js", "profile-tabs.js", "content.js", "media-source.js", "media-grid.js", "lightbox-panel.js"],
			"css": ["style.css"],
			"run_at": "document_end"
		},
		{
			"matches": ["*://bsky.app/*"],
			"js": ["page-bridge.js"],
			"run_at": "document_end",
			"world": "MAIN"
		}
	]
}
